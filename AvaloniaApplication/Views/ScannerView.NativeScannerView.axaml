<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="AvaloniaApplication.Views.ScannerView.NativeScannerView"
    xmlns:vm="clr-namespace:AvaloniaApplication.ViewModels"
    mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
    x:DataType="vm:ScannerViewNativeViewModel"
    xmlns:zxing="using:ZXing.Net.Maui.Controls"
    xmlns:controls="using:Avalonia.Maui.Controls"
    xmlns:local="clr-namespace:AvaloniaApplication">

    <Grid ColumnDefinitions="*" RowDefinitions="*">
        <controls:MauiControlHost
            Grid.Column="0" Grid.Row="0"
            x:Name="cameraBarcodeReaderHost">
            <zxing:CameraBarcodeReaderView
                BarcodesDetected="BarcodesDetected"/>
        </controls:MauiControlHost>

        <local:NativeScannerButtonHost
            Grid.Column="0" Grid.Row="0"
            IsVisible="{Binding ShowButtons}"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            x:Name="nativeButtonHost"/>
    </Grid>
</UserControl>
