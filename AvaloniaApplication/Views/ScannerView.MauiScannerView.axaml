<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="AvaloniaApplication.Views.ScannerView.MauiScannerView"
    xmlns:vm="clr-namespace:AvaloniaApplication.ViewModels"
    mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
    x:DataType="vm:ScannerViewMauiViewModel"
    xmlns:controls="using:Avalonia.Maui.Controls">

    <controls:MauiControlHost
        x:Name="mauiHost"/>
</UserControl>
